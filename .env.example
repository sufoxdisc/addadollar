# Copy this file to ".env" and fill in your values.
# NEVER commit the .env file (it's already in .gitignore).

PORT=3000

# "production" = HTTPS redirect + HSTS, Stripe required, moderation required.
# Use "development" on your own computer.
NODE_ENV=development

# Public address of the site. Used for redirects and for Stripe's success/cancel URLs.
# In production this MUST be your https:// address.
BASE_URL=http://localhost:3000

# Number of reverse proxies in front of the app (Caddy/nginx = 1, none = 0).
# Needed so the app sees the real visitor IP and knows when a request was HTTPS.
TRUST_PROXY=0

# Redirect all HTTP traffic to HTTPS with a 301 (defaults to on when NODE_ENV=production).
FORCE_HTTPS=false

# --- Payments ---
# "stripe" for real payments, "simulated" for a fake pay button (development only).
PAYMENT_MODE=simulated

# Stripe keys. Server-side only. Never expose them in the browser or commit them.
# STRIPE_SECRET_KEY can be a secret key (sk_live_...) or a restricted key (rk_live_...)
# that has "Checkout Sessions: Write" permission.
STRIPE_SECRET_KEY=
# Signing secret of your webhook endpoint (Stripe Dashboard > Developers > Webhooks).
STRIPE_WEBHOOK_SECRET=
# Not used by hosted Checkout. Safe to be public.
STRIPE_PUBLISHABLE_KEY=

# Share of each payment counted for charity (0.5 = 50%).
CHARITY_SHARE=0.5

# --- Moderation ---
# OpenAI API key for the Moderation endpoint. Required when NODE_ENV=production.
OPENAI_API_KEY=

# --- Misc ---
# Max submission attempts per minute, per IP
RATE_LIMIT_PER_MIN=12

# JSON database file (created and seeded on first launch)
DATA_FILE=./data/db.json
